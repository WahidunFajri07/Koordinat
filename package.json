  "description": "Sistem Rekonsiliasi Data Pelanggan PLN — Root Workspace",
  "scripts": {
    "start": "npm --prefix frontend run dev",
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
