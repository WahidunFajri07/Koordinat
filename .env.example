# ============================================================
# Rekonsiliasi Data Pelanggan — Environment Variables
# ============================================================
# Salin file ini ke .env dan isi nilainya.
# JANGAN commit file .env ke repository!
# ============================================================

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rekonsiliasi
POSTGRES_USER=rekon_user
POSTGRES_PASSWORD=changeme_postgres_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Celery ----
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Keycloak / OIDC ----
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=rekonsiliasi
KEYCLOAK_CLIENT_ID=rekonsiliasi-frontend
KEYCLOAK_CLIENT_SECRET=changeme_client_secret
OIDC_ISSUER_URL=http://keycloak:8080/realms/rekonsiliasi
OIDC_JWKS_URL=http://keycloak:8080/realms/rekonsiliasi/protocol/openid-connect/certs

# ---- Enkripsi IDPEL ----
# Generate with: python scripts/generate_keys.py
ENCRYPTION_KEY=changeme_base64_encoded_32_byte_key
BLIND_INDEX_KEY=changeme_base64_encoded_32_byte_key

# ---- Map Provider ----
# "mapbox" (default) atau "google"
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=pk.changeme
GOOGLE_MAPS_API_KEY=changeme

# ---- Frontend (diawali VITE_ agar terexpose ke browser) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=rekonsiliasi
VITE_KEYCLOAK_CLIENT_ID=rekonsiliasi-frontend
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=pk.changeme

# ---- App Config ----
APP_NAME=Rekonsiliasi Data Pelanggan
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme_random_secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
MAX_UPLOAD_SIZE_MB=200
IDPEL_LENGTH=12
DEFAULT_MATCH_TOLERANCE_METERS=25
MAX_CANDIDATES_PER_KOSONG=10
AUDIT_LOG_RETENTION_MONTHS=6
UPLOAD_DIR=/app/uploads

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
